rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: GLOBAL HELPERS ---
    
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "gauravsinghthakursingh@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- ENTITY VALIDATORS ---

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number && data.price >= 0 &&
             data.category in ["Flower Seeds", "Indoor Plants", "Outdoor Plants", "Flowering Plants"] &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             (data.images == null || (data.images is list && data.images.size() <= 10)) &&
             data.stock is int && data.stock >= 0 &&
             data.sunlight in ["Low", "Medium", "High"] &&
             data.season in ["Spring", "Summer", "Autumn", "Winter", "All Year"] &&
             data.createdAt is int &&
             data.keys().hasAll(['name', 'price', 'category', 'imageUrl', 'stock']) &&
             data.keys().size() <= 16;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ["user", "admin"] &&
             data.createdAt is int &&
             data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidOrder(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ["pending", "processing", "shipped", "delivered", "cancelled"] &&
             data.shippingAddress is map &&
             data.paymentMethod in ["UPI", "Card", "COD"] &&
             data.createdAt is int &&
             data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'shippingAddress', 'paymentMethod', 'createdAt']) &&
             data.keys().size() <= 12;
    }

    function isValidReview(data) {
      return data.productId is string && isValidId(data.productId) &&
             data.userId is string && isValidId(data.userId) &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >=1 && data.comment.size() <= 1000 &&
             data.createdAt is int &&
             data.keys().hasAll(['productId', 'userId', 'rating', 'comment', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidWishlistItem(data) {
      return data.productId is string && isValidId(data.productId) &&
             data.userId is string && isValidId(data.userId) &&
             data.createdAt is int &&
             data.keys().hasAll(['productId', 'userId', 'createdAt']) &&
             data.keys().size() == 3;
    }

    // --- COLLECTION RULES ---

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      // PII Isolation: email is protected.
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().role == 'user' && 
                    incoming().createdAt == request.time.toMillis() &&
                    isValidId(userId);
      
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Protect role escalation
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        // Named Actions
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email'])
      ) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isVerified() && 
                    isValidOrder(incoming()) && 
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending' &&
                    incoming().createdAt == request.time.toMillis() &&
                    isValidId(orderId) &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
                    
      allow update: if isAdmin() && isValidOrder(incoming()) && (
        // Admin updates status
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        // Terminal State Locking
        existing().status != 'delivered' && existing().status != 'cancelled'
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      
      allow create: if isVerified() && 
                    isValidReview(incoming()) && 
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time.toMillis() &&
                    isValidId(reviewId) &&
                    exists(/databases/$(database)/documents/products/$(incoming().productId));
                    
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /wishlist/{wishlistId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isVerified() && 
                    isValidWishlistItem(incoming()) && 
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time.toMillis() &&
                    isValidId(wishlistId) &&
                    exists(/databases/$(database)/documents/products/$(incoming().productId));
                    
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
