{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A plant or seed product for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product" },
        "description": { "type": "string", "description": "Detailed description" },
        "price": { "type": "number", "description": "Price in INR" },
        "category": { "type": "string", "enum": ["Flower Seeds", "Indoor Plants", "Outdoor Plants", "Flowering Plants"] },
        "imageUrl": { "type": "string", "format": "uri" },
        "stock": { "type": "integer", "description": "Available quantity" },
        "careInstructions": { "type": "string", "description": "How to care for the plant" },
        "sunlight": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "season": { "type": "string", "enum": ["Spring", "Summer", "Autumn", "Winter", "All Year"] },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["name", "price", "category", "imageUrl", "stock"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string", "enum": ["UPI", "Card", "COD"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "items", "totalAmount", "status", "shippingAddress", "paymentMethod"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review by a user",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    },
    "WishlistItem": {
      "title": "Wishlist Item",
      "description": "A product saved to user's wishlist",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["productId", "userId"]
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Store plant products" },
    "/users/{userId}": { "schema": "UserProfile", "description": "Store user profiles" },
    "/orders/{orderId}": { "schema": "Order", "description": "Store customer orders" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Store product reviews" },
    "/wishlist/{wishlistId}": { "schema": "WishlistItem", "description": "Store user wishlists" }
  }
}
